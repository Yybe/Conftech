# Copy to .env and fill in your keys

# OpenCode Zen gateway (OpenAI-compatible). Get a key at https://opencode.ai/auth
OPENROUTER_API_KEY=sk-...
# Optional: gateway base URL (defaults to https://opencode.ai/zen/v1)
# OPENROUTER_BASE_URL=https://opencode.ai/zen/v1
# Primary model; falls back to LLM_FALLBACK_MODEL on error / rate limit / invalid JSON
LLM_MODEL=deepseek-v4-flash-free
LLM_FALLBACK_MODEL=mimo-v2.5-free
# Reasoning effort: "none" (default) disables hidden reasoning so DeepSeek V4
# Flash spends every token on the answer; "low"/"medium"/"high" re-enable it.
# LLM_REASONING_EFFORT=none

SERPER_API_KEY=your_serper_key

# TheirStack key must be sent as Authorization: Bearer <key>
THEIRSTACK_API_KEY=your_theirstack_jwt

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: enables automated `python app.py init-db` via the Management API
# SUPABASE_ACCESS_TOKEN=sb_pat_...

CACHE_DIR=.cache
CACHE_TTL_DAYS=7
